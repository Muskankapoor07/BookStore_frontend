<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <rect width="100" height="100" rx="18" fill="#ffffff"/>
  <g fill="none" stroke="#000000" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left outer cover vertical edge -->
    <line x1="16" y1="28" x2="16" y2="76" />
    
    <!-- Right outer cover vertical edge -->
    <line x1="84" y1="28" x2="84" y2="76" />
    
    <!-- Bottom cover spine curve -->
    <path d="M16 76 Q50 90 84 76" />
    
    <!-- Left page outline -->
    <path d="M24 20 Q37 15 50 24 L50 72 Q37 63 24 68 Z" fill="#ffffff" />
    
    <!-- Right page outline -->
    <path d="M76 20 Q63 15 50 24 L50 72 Q63 63 76 68 Z" fill="#ffffff" />
    
    <!-- Center page spine line -->
    <line x1="50" y1="24" x2="50" y2="72" />
  </g>
</svg>

